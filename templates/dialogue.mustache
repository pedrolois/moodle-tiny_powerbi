{{!
    @template tiny_powerbi/dialogue

    Insert or edit a Power BI report.

    Context variables required for this template:
    * uniqid - Unique prefix for element ids.
    * link, title, height, filtertable, filtercolumn, rlsrole - Current values.
    * navpane, filterpane - Checkbox states.
    * canbrowse - The site's app registration can list reports.
    * modes, filters - Options: value, label, selected, disabled.

    Example context (json):
    {
        "uniqid": "id_editor_powerbi",
        "link": "",
        "title": "",
        "height": 600,
        "canbrowse": true,
        "navpane": true,
        "filterpane": false,
        "modes": [{"value": "", "label": "Site default", "selected": true}],
        "filters": [{"value": "none", "label": "No filter", "selected": true}]
    }
}}
<div class="tiny-powerbi">
    {{#canbrowse}}
    <fieldset class="mb-3">
        <legend class="form-label fs-6 h6 mb-2">{{#str}}browse, tiny_powerbi{{/str}}</legend>
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label small" for="{{uniqid}}_workspace">{{#str}}workspace, tiny_powerbi{{/str}}</label>
                <select class="form-select custom-select" id="{{uniqid}}_workspace" data-region="workspace" disabled></select>
            </div>
            <div class="col-md-4">
                <label class="form-label small" for="{{uniqid}}_report">{{#str}}report, tiny_powerbi{{/str}}</label>
                <select class="form-select custom-select" id="{{uniqid}}_report" data-region="report" disabled></select>
            </div>
            <div class="col-md-4">
                <label class="form-label small" for="{{uniqid}}_page">{{#str}}page, tiny_powerbi{{/str}}</label>
                <select class="form-select custom-select" id="{{uniqid}}_page" data-region="page" disabled></select>
            </div>
        </div>
    </fieldset>
    {{/canbrowse}}

    <div class="mb-3">
        <label class="form-label" for="{{uniqid}}_link">{{#str}}link, tiny_powerbi{{/str}}</label>
        <input type="url" class="form-control" id="{{uniqid}}_link" data-region="link" value="{{link}}"
            placeholder="https://app.powerbi.com/groups/…/reports/…" aria-describedby="{{uniqid}}_link_help">
        <div class="form-text small text-muted" id="{{uniqid}}_link_help">{{#str}}link_help, tiny_powerbi{{/str}}</div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-8">
            <label class="form-label" for="{{uniqid}}_title">{{#str}}title, tiny_powerbi{{/str}}</label>
            <input type="text" class="form-control" id="{{uniqid}}_title" data-region="reporttitle" value="{{title}}" maxlength="200">
        </div>
        <div class="col-md-4">
            <label class="form-label" for="{{uniqid}}_height">{{#str}}height, tiny_powerbi{{/str}}</label>
            <input type="number" class="form-control" id="{{uniqid}}_height" data-region="height" value="{{height}}"
                min="200" max="2000" step="50">
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="{{uniqid}}_mode">{{#str}}mode, tiny_powerbi{{/str}}</label>
        <select class="form-select custom-select" id="{{uniqid}}_mode" data-region="mode">
            {{#modes}}
            <option value="{{value}}"{{#selected}} selected{{/selected}}{{#disabled}} disabled{{/disabled}}>{{label}}</option>
            {{/modes}}
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label" for="{{uniqid}}_filterby">{{#str}}filterby, tiny_powerbi{{/str}}</label>
        <select class="form-select custom-select" id="{{uniqid}}_filterby" data-region="filterby">
            {{#filters}}
            <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
            {{/filters}}
        </select>
    </div>
    <div class="row g-2 mb-1" data-region="filterfields">
        <div class="col-md-6">
            <label class="form-label small" for="{{uniqid}}_table">{{#str}}filtertable, tiny_powerbi{{/str}}</label>
            <input type="text" class="form-control" id="{{uniqid}}_table" data-region="filtertable" value="{{filtertable}}">
        </div>
        <div class="col-md-6">
            <label class="form-label small" for="{{uniqid}}_column">{{#str}}filtercolumn, tiny_powerbi{{/str}}</label>
            <input type="text" class="form-control" id="{{uniqid}}_column" data-region="filtercolumn" value="{{filtercolumn}}">
        </div>
        <div class="col-12 form-text small text-muted mb-2">{{#str}}filter_help, tiny_powerbi{{/str}}</div>
    </div>

    <div class="mb-3" data-region="rlsfields">
        <label class="form-label" for="{{uniqid}}_role">{{#str}}rlsrole, tiny_powerbi{{/str}}</label>
        <input type="text" class="form-control" id="{{uniqid}}_role" data-region="rlsrole" value="{{rlsrole}}"
            aria-describedby="{{uniqid}}_role_help">
        <div class="form-text small text-muted" id="{{uniqid}}_role_help">{{#str}}rlsrole_help, tiny_powerbi{{/str}}</div>
    </div>

    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="{{uniqid}}_nav" data-region="navpane"{{#navpane}} checked{{/navpane}}>
        <label class="form-check-label" for="{{uniqid}}_nav">{{#str}}navpane, tiny_powerbi{{/str}}</label>
    </div>
    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="{{uniqid}}_filters" data-region="filterpane"{{#filterpane}} checked{{/filterpane}}>
        <label class="form-check-label" for="{{uniqid}}_filters">{{#str}}filterpane, tiny_powerbi{{/str}}</label>
    </div>

    <div data-region="error" role="alert"></div>
</div>
